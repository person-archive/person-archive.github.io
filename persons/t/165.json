279#39"},"name":"大関増勤","roles":["勅任","華族","即𦾔","藩主"],"add_name":["通称泰次郎"],"seg":["戊辰十八歳"],"place_name":[],"events":[{"date":"明治元年戊辰六月十一日","description":"白川口人夫操出可致旨御無沙汰候事但蘆野雄之助大久保三九郎大田原鉎丸ヘモ同様被仰付候間各藩申合精々盡力可致候事"},{"date":"六月十一日","description":"白川口總督府参謀"},{"date":"同年七月二日","description":"棚倉并近邉領分當時取締可被致候様鷲尾殿御沙汰候事"},{"date":"辰七月","description":"白川口出張参謀補助"},{"date":"同年同月七日","description":"浅川塙釜子三陣屋當時取締可被致旨鷲尾殿御沙汰候事"},{"date":"辰七月","description":"白川口出張参謀補助"},{"date":"同年同月","description":"白川口人夫操出方被仰付置候處以来隨地理人馬舟車ヲ以運轉無差支精々取計候様更ニ被仰付候事"},{"date":"七月","description":"大總督"},{"date":"同年同月","description":"先般以来白川口進撃之節屢憤戰之趣神妙之至ニ候此旨速ニ可遂奏聞候猶歒愾之士氣不相弛彌勉勵勤労可有之候仍感状如件"},{"date":"同年十月九日","description":"若松落城相成候就テハ追々脱走之残賊兩野州ニ潜伏暴行モ難計候間兩野州之藩々若松進軍之兵隊ハ早々凱陣休兵被申付候條尚精々領内取締可為肝要旨御沙汰候事"},{"date":"","description":"十月"},{"date":"同年十一月朔日","description":"参内御誓約被仰付候事"},{"date":"同年同月十九日","description":"任美作守 叙従五位下"},{"date":"同年同月二十一日","description":"其方儀今般御誓約相濟御暇賜候條歸邑之上ハ御誓文之御趣意ヲ奉體シ家政向改正ハ勿論東北既ニ平定ニ至ト雖モ前途皇国御維持之儀深ク御苦慮被為遊候ニ付屹度藩屏之職ヲ重シ緩急御用相立候様御沙汰候事"},{"date":"十一月","description":"行政官"},{"date":"二年己巳二月九日","description":"南部彦太郎舊領別紙郷村高帳之通今般其藩へ取締被仰付候兵亂之餘人民疾苦之情状被聞含深ク被為痛聖念候ニ付兼テ民生相心得居候家来精撰致彼地出張申付朝廷御政體ニ基キ人民撫育ニ厚心ヲ用御一新之御趣意洽ク貫徹致候様可取計旨御沙汰候事 但地所之儀ハ南部彦太郎ヘ縣令早々受取可申事"},{"date":"二月","description":"行政官"},{"date":"同日","description":"先般總督府ヨリ棚倉表民政取締可致旨相違置候處今般被免候間棚倉城之儀ハ阿部基之助へ引渡可申旨御沙汰候事"},{"date":"二月","description":"行政官"},{"date":"同年六月二日","description":"高一万五千石 依戰功永世下賜候事"},{"date":"","description":"六月"},{"date":"同日","description":"小藩ヲ以テ賊域ニ介在シ斷然方嚮ヲ決シ各所奮勵毎戰奏功藩屏之任ヲ遂候段叡感不浅仍テ為其賞一万五千石下賜候事"},{"date":"六月","description":"行政官"},{"date":"同年同月二十三日","description":"黒羽藩知事被仰付候事"},{"date":"同日","description":"今般版籍奉還之儀ニ付深ク時勢ヲ被為察廣ク公議ヲ被為採政令歸一之思食ヲ以テ言上之通被聞食候事"},{"date":"六月","description":"行政官"},{"date":"同年七月四日","description":"参朝拜天盃頂戴被仰付候事"},{"date":"同日","description":"勅詔先達テヨリ會議孰モ太儀ニ存ス尚歸藩之上職掌ヲ盡シ勵精可致"},{"date":"同日","description":"大政御諮詢之為會同衆議苦勞ニ被思召候先達テ來御下問之件々尚御参酌之上追々御施行可被為在候此度歸藩被仰付御間各御趣意ヲ奉體シ可職任旨御沙汰候事"},{"date":"四年辛未二月二十日","description":"東京府貫屬被仰付候事"},{"date":"同年七月十四日","descrip